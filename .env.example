PORT=4002
NODE_ENV=development

# Same secret as core-service/order-service — this service only verifies.
ACCESS_SECRET=change-me

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=quickbite_analytics
MONGO_CONNECT_TIMEOUT_SEC=10

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_ANALYTICS_QUEUE=analytics-service.order-events
RABBITMQ_ANALYTICS_BINDINGS=order.#,payment.#
RABBITMQ_ANALYTICS_DLX=order.events.dlx
RABBITMQ_ANALYTICS_DLQ=analytics-service.order-events.dlq
RABBITMQ_PREFETCH=32

# core.events is a second exchange (declared by core-service), unrelated to
# order.events above — this is a second consumer/queue/binding, not a new
# routing key on the existing one. Feeds the rbac.permissions_changed
# consumer only (lib/rbac/eventhandler.go).
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_ANALYTICS_CORE_EVENTS_QUEUE=analytics-service.core-events
RABBITMQ_ANALYTICS_CORE_EVENTS_BINDINGS=rbac.permissions_changed
RABBITMQ_ANALYTICS_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_ANALYTICS_CORE_EVENTS_DLQ=analytics-service.core-events.dlq

# In dev, point this at play/mock-core (see README) instead of a real
# core-service so the slice is testable standalone.
CORE_SERVICE_BASE_URL=http://localhost:4100
CORE_INTERNAL_API_KEY=dev_internal_api_key_local_only
CORE_HTTP_TIMEOUT_MS=5000

# order-service — read-only HTTP dependency for cmd/backfill-aggs only (the
# live api process never calls this). Must match order-service's own
# INTERNAL_API_KEY (order-service's .env.example, guards its
# /api/internal/orders/history endpoint).
ORDER_SERVICE_BASE_URL=http://localhost:4000
ORDER_SERVICE_INTERNAL_API_KEY=dev_internal_api_key_local_only

RBAC_CACHE_TTL_SEC=300
EVENT_DEDUPE_TTL_DAYS=7

# How long the order.placed -> order.delivered/order.rejected lookup
# (order_context) survives before Mongo's TTL reaper drops it. Must outlive
# the slowest realistic order lifecycle.
ORDER_CONTEXT_TTL_DAYS=45
